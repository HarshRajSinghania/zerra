# ────────────────────────────────────────────────────────────────────────────
# Zerra Environment Configuration
# Copy this file to .env and fill in the values you need.
# Never commit your .env file to version control.
# ────────────────────────────────────────────────────────────────────────────

# ── Required: Database ───────────────────────────────────────────────────────
# Full Postgres connection string.  The compose.yaml ships a local Postgres
# instance — only change this if you bring your own external database.
DB_CONN_STR=postgresql://zerra:zerra@postgres:5432/zerra
DATABASE_URL=postgresql://zerra:zerra@postgres:5432/zerra?schema=public
POSTGRES_DB=zerra
POSTGRES_USER=zerra
POSTGRES_PASSWORD=zerra

# ── Required: Security ───────────────────────────────────────────────────────
# JWT signing secret.  Must be at least 32 characters.
# Generate: openssl rand -base64 32
JWT_SECRET=
JWT_TTL_HOURS=24

# ── Required: App URLs ───────────────────────────────────────────────────────
BASE_DOMAIN=localhost
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── AI Inference (Zerra Agent) ───────────────────────────────────────────────
# Local Ollama — no API key needed if you run Ollama on your machine.
# Install: https://ollama.ai | Default model: llama3.2
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2

# Anthropic Claude — optional; used for AI fix generation if Ollama unavailable
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-20240307

# OpenAI — optional; last-resort fallback for AI fix generation
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── Inference service routing ────────────────────────────────────────────────
ZERRA_INFERENCE_URL=http://inference:8000
ZERRA_INFERENCE_ENABLED=true

# ── GitHub Integration ───────────────────────────────────────────────────────
# Fine-grained PAT for opening Pull Requests from your device.
# Required permissions: Contents (R/W), Pull Requests (R/W), Issues (R/W).
# Create at: https://github.com/settings/tokens?type=beta
GITHUB_TOKEN=

# Webhook secret — set this to the same value as your GitHub webhook secret
# if you expose Zerra to receive push/PR webhooks.
GITHUB_WEBHOOK_SECRET=

# ── Next.js Dashboard ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_ZERRA_URL=http://localhost:8000

# ── Redis (optional — for job queue persistence) ─────────────────────────────
# The in-memory queue is used if Redis is not available.
REDIS_URL=redis://redis:6379

# ── Notifications ────────────────────────────────────────────────────────────
# Slack incoming webhook URL — leave empty to disable
SLACK_WEBHOOK_URL=

# Discord incoming webhook URL — leave empty to disable
DISCORD_WEBHOOK_URL=

# Email (SMTP) — leave SMTP_HOST empty to disable
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=zerra@localhost
NOTIFICATION_EMAIL_TO=

# ── Vault ────────────────────────────────────────────────────────────────────
# Optional: set a base64-encoded 32-byte master key for the file-based vault.
# If empty, Zerra will generate one automatically at ~/.zerra/.key.
# Generate: python3 -c "import secrets,base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ZERRA_VAULT_KEY=

# ── Scanner ──────────────────────────────────────────────────────────────────
# Docker image used for the Go scanner worker (OWASP active scan).
ZERRA_SCANNER_IMAGE=scanner

# Maximum time (seconds) for a single sandbox scan run
SANDBOX_TIMEOUT_SECONDS=300

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info
